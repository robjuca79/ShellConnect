<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>15.0</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<SpadNextDirectory Condition="'$(SpadNextDirectory)' == ''">C:\Program Files\SPAD.neXt</SpadNextDirectory>
		<Title>Connect Shell</Title>
		<Version>1.0.2026.10</Version>
		<Authors>Roberto Jucá (robjuca@pobox.com) Copyright © R&amp;R Soft 2001</Authors>
		<Company>R&amp;R Soft</Company>
		<Description>This .NET assembly is a library.</Description>
		<Copyright>R&amp;R Soft® is a registered trademark of R&amp;R Soft.</Copyright>
		<AssemblyName>Connect.Shell</AssemblyName>
		<BaseOutputPath>D:\GitHub\ShellConnect\Bin</BaseOutputPath>
		<OutputPath>D:\GitHub\ShellConnect\Bin</OutputPath>
		<OutputType>Library</OutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Visual Studio 18\**" />
	  <EmbeddedResource Remove="Visual Studio 18\**" />
	  <None Remove="Visual Studio 18\**" />
	  <Page Remove="Visual Studio 18\**" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="desktop.ini" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Connect.Provider.Data">
			<HintPath>..\..\..\Bin\Connect.Provider.Data.dll</HintPath>
		</Reference>
		<Reference Include="Connect.Provider.Enumerator">
			<HintPath>..\..\..\Bin\Connect.Provider.Enumerator.dll</HintPath>
		</Reference>
		<Reference Include="Connect.Provider.Interface">
			<HintPath>..\..\..\Bin\Connect.Provider.Interface.dll</HintPath>
		</Reference>
		<Reference Include="SPAD.Interfaces">
			<HintPath>$(SpadNextDirectory)\SPAD.Interfaces.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Condition="'$(SkipAddonDeployment)' != 'true'" Command="xcopy &quot;$(TargetPath)&quot;  D:\SPAD.neXt\Addons /Y" />
	<Copy Condition="'$(SkipAddonDeployment)' != 'true'" SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="D:\SPAD.neXt\Addons" SkipUnchangedFiles="true" />
	</Target>
	<ItemGroup>
	</ItemGroup>
</Project>
